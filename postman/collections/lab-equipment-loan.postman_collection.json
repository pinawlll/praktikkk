{
  "info": {
    "name": "Lab Equipment Loan System",
    "description": "Endpoint checks for the Lab Equipment Loan System. Run against a freshly initialized database: flask --app run.py init-db",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "GET /items (empty database)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('items is an array', () => pm.expect(pm.response.json().items).to.be.an('array'));",
              "pm.test('items is empty', () => pm.expect(pm.response.json().items).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /items (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Multimeter\", \"total_stock\": 10}"
        },
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const item = pm.response.json();",
              "pm.test('name is stored', () => pm.expect(item.name).to.eql('Multimeter'));",
              "pm.test('available stock equals total stock', () => pm.expect(item.available_stock).to.eql(item.total_stock));",
              "pm.collectionVariables.set('itemId', item.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /items (missing name)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"total_stock\": 5}"
        },
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error message is returned', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /items (after create)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "const created = items.find((item) => String(item.id) === String(pm.collectionVariables.get('itemId')));",
              "pm.test('created item is listed', () => pm.expect(created).to.be.an('object'));",
              "pm.test('stock is 10', () => pm.expect(created.available_stock).to.eql(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /loans (valid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"student_id\": \"20240001\", \"item_id\": {{itemId}}, \"quantity\": 3}"
        },
        "url": "{{baseUrl}}/loans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const loan = pm.response.json();",
              "pm.test('status is BORROWED', () => pm.expect(loan.status).to.eql('BORROWED'));",
              "pm.test('quantity is 3', () => pm.expect(loan.quantity).to.eql(3));",
              "pm.collectionVariables.set('loanId', loan.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /items (after borrow)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "const item = items.find((entry) => String(entry.id) === String(pm.collectionVariables.get('itemId')));",
              "pm.test('stock decreased to 7', () => pm.expect(item.available_stock).to.eql(7));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /loans (insufficient stock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"student_id\": \"20240001\", \"item_id\": {{itemId}}, \"quantity\": 99}"
        },
        "url": "{{baseUrl}}/loans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error mentions stock', () => pm.expect(pm.response.json().error).to.include('stock'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /loans (unknown item)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"student_id\": \"20240001\", \"item_id\": 9999, \"quantity\": 1}"
        },
        "url": "{{baseUrl}}/loans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error message is returned', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /loans/student/20240001",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/loans/student/20240001"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const loans = pm.response.json().loans;",
              "pm.test('one loan is returned', () => pm.expect(loans).to.have.lengthOf(1));",
              "pm.test('loan belongs to the student', () => pm.expect(loans[0].student_id).to.eql('20240001'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /loans/student/00000000 (no loans)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/loans/student/00000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('loans is empty', () => pm.expect(pm.response.json().loans).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /loans/{{loanId}}/return",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/loans/{{loanId}}/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('status is RETURNED', () => pm.expect(pm.response.json().status).to.eql('RETURNED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /loans/{{loanId}}/return (again)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/loans/{{loanId}}/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('error message is returned', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /items (after return)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items;",
              "const item = items.find((entry) => String(entry.id) === String(pm.collectionVariables.get('itemId')));",
              "pm.test('stock restored to 10', () => pm.expect(item.available_stock).to.eql(10));",
              "pm.test('stock never exceeds total stock', () => pm.expect(item.available_stock).to.be.at.most(item.total_stock));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /loans/9999/return (unknown loan)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/loans/9999/return"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('error message is returned', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    }
  ]
}
